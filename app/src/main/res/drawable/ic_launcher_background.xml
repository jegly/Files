<?xml version="1.0" encoding="utf-8"?>
<!-- Flat fill sampled from the average of the foreground gradient.

     Nothing of this is normally visible: the foreground is a full-bleed circle whose diameter is
     the whole 108dp layer, so it covers every mask the system applies, circle or squircle. It is
     here because a layer that is only ever fully covered is still the thing that shows if a
     launcher composites the two differently, and a matching tone fails invisibly where the old
     transparent default would have flashed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#BBD098"
        android:pathData="M0,0h108v108h-108z" />
</vector>
