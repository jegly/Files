<?xml version="1.0" encoding="utf-8"?>
<!-- Themed icons are tinted flat by the system, so this layer carries shape and nothing else.
     The icon is a gradient sphere with no symbol inside it, and a gradient has no silhouette to
     trace — so the honest monochrome of it is the disc itself. Drawn full-bleed to match the
     foreground, which means a themed launcher renders a solid tinted circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,0A54,54 0,1 1,54 108A54,54 0,1 1,54 0Z" />
</vector>
